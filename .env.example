# ============================================================
#  Apple Store 门市取货监控 —— 邮箱凭据
#  复制本文件为 .env 并填写即可（.env 绝对不要提交到 git）
#
#  这个文件只管「邮箱凭据」和少量高级参数。
#  要监控哪些门店 / 机型，请打开设置界面（打开设置界面.bat），
#  或者直接改 config.json —— 那些配置界面会写，不用手改这里。
# ============================================================

# ---------- 邮件设置（QQ邮箱） ----------
# 1) 登录 QQ邮箱网页版 → 设置 → 账号
# 2) 找到「POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务」
# 3) 开启「IMAP/SMTP服务」，按提示发短信，得到一串 16 位「授权码」
# 4) 把这个授权码填到下面 SMTP_PASS（不是你的QQ登录密码！）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=你的16位SMTP授权码

# 发件人（一般和 SMTP_USER 相同）
MAIL_FROM=你的QQ邮箱@qq.com
# 收件人，可以填多个，用英文逗号分隔
MAIL_TO=接收通知的邮箱@qq.com


# ---------- 高级（一般不用改） ----------
# 单次请求超时（毫秒）
REQUEST_TIMEOUT_MS=25000
# 拿不到可信数据时的最大重试次数
MAX_RETRIES=6
# 每隔多少分钟重建一次 Apple 会话
SESSION_REFRESH_MINUTES=30
# 自定义 User-Agent（被 Apple 拦时才需要改）
# USER_AGENT=
# 状态文件 / 日志文件路径（默认在项目根目录）
# STATE_FILE=
# LOG_FILE=
