{
  "name": "apple-pickup-monitor",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "监控中国大陆 / 香港 Apple Store 门市取货库存（任意机型 / 容量 / 颜色 / 门店），有货时邮件通知",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "once": "node src/index.js --once",
    "test-email": "node src/index.js --test-email",
    "test": "node test/settings.mjs && node test/positive-path.mjs && node --test test/reliability.mjs",
    "test:ui": "node test/ui.mjs",
    "test:live": "node test/live.mjs",
    "build-catalog": "node tools/build-catalog.mjs",
    "test:air-live": "node test/air-regions-live.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  }
}
